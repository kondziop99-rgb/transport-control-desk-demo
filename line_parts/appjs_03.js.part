function renderTimeline(){const cats=[...new Set(S.order.audit.map(a=>a.event_type))];$('#tabBody').innerHTML=`<div class="panel"><div class="filterbar"><select id="auditFilter" onchange="renderTimelineFiltered()"><option value="">wszystkie zdarzenia</option>${cats.map(c=>`<option>${esc(c)}</option>`).join('')}</select><button class="ghost" onclick="auditNoteModal()">+ Ręczna notatka</button></div><div id="timelineBody"></div></div>`;renderTimelineFiltered();}
function renderTimelineFiltered(){const f=$('#auditFilter')?.value||'';const a=S.order.audit.filter(x=>!f||x.event_type===f);$('#timelineBody').innerHTML=`<div class="timeline">${a.map(x=>`<div class="event"><div class="event-time">${fmt(x.created_at)}<br>${esc(x.source)}</div><div><div class="event-title">${esc(x.summary)}</div><div class="event-meta">${esc(x.user_name||'system')} · ${esc(x.event_type)} · ${esc(x.verification)}</div>${(x.comments||[]).map(c=>`<div class="comment">${esc(c.user_name)}: ${esc(c.comment)}</div>`).join('')}<button class="mini" style="margin-top:6px" onclick="commentAudit(${x.id})">komentarz</button></div></div>`).join('')}</div>`}
function auditNoteModal(){showModal(`<h2>Ręczna notatka do historii</h2><div class="field"><label>Treść</label><textarea id="anText"></textarea></div><div class="field"><label>Weryfikacja</label><select id="anVer"><option value="verified">potwierdzona informacja</option><option value="unverified">niezweryfikowana informacja</option></select></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveAuditNote()">Dodaj</button></div>`)}
async function saveAuditNote(){await api('/api/orders/'+S.order.order.id+'/audit-notes',{method:'POST',body:JSON.stringify({summary:$('#anText').value,verification:$('#anVer').value})});closeModal();await openOrder(S.order.order.id);S.activeTab='timeline';renderOrder();}
function commentAudit(id){showModal(`<h2>Komentarz do wpisu</h2><div class="field"><textarea id="acText"></textarea></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveAuditComment(${id})">Dodaj</button></div>`)}
async function saveAuditComment(id){await api('/api/audit/'+id+'/comments',{method:'POST',body:JSON.stringify({comment:$('#acText').value})});closeModal();await openOrder(S.order.order.id);S.activeTab='timeline';renderOrder();}
function renderMilestones(){const m=S.order.milestones;$('#tabBody').innerHTML=`<div class="panel"><div class="actions-row" style="justify-content:flex-start;margin-top:0"><button class="ghost" onclick="milestoneModal(true)">+ Z sugestii</button><button class="ghost" onclick="milestoneModal(false)">+ Własny milestone</button></div><div style="margin-top:10px">${m.map(x=>`<div class="milestone"><div class="seq">${x.seq}</div><div><b>${esc(x.name)}</b><div class="muted">${esc(x.comment||'')}</div></div><select class="mini" onchange="patchMilestone(${x.id},{status:this.value})"><option ${x.status==='pending'?'selected':''}>pending</option><option ${x.status==='active'?'selected':''}>active</option><option ${x.status==='blocked'?'selected':''}>blocked</option><option ${x.status==='done'?'selected':''}>done</option></select><div>${fmt(x.deadline)}</div><div>${esc(x.owner_name||'—')}</div><button class="mini" onclick="editMilestone(${x.id})">edytuj</button></div>`).join('')}</div></div>`}
function milestoneModal(suggest){showModal(`<h2>${suggest?'Dodaj sugerowany milestone':'Nowy milestone'}</h2><div class="modal-grid"><div class="field span2"><label>Nazwa</label>${suggest?`<select id="msName">${S.bootstrap.suggested_milestones.map(x=>`<option>${esc(x)}</option>`).join('')}</select>`:'<input id="msName">'}</div><div class="field"><label>Kolejność</label><input id="msSeq" type="number" value="250"></div><div class="field"><label>Deadline</label><input id="msDeadline" type="datetime-local"></div><div class="field"><label>Owner</label><select id="msOwner"><option value="">—</option>${S.users.map(u=>`<option value="${u.id}">${esc(u.name)}</option>`).join('')}</select></div><div class="field"><label>Komentarz</label><input id="msComment"></div></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveMilestone()">Dodaj</button></div>`)}
async function saveMilestone(){await api('/api/orders/'+S.order.order.id+'/milestones',{method:'POST',body:JSON.stringify({name:$('#msName').value,seq:+$('#msSeq').value,deadline:$('#msDeadline').value||null,owner_user_id:+$('#msOwner').value||null,comment:$('#msComment').value})});closeModal();await openOrder(S.order.order.id);S.activeTab='milestones';renderOrder();}
async function patchMilestone(id,data){await api('/api/milestones/'+id,{method:'PATCH',body:JSON.stringify(data)});await openOrder(S.order.order.id);S.activeTab='milestones';renderOrder();}
function editMilestone(id){const x=S.order.milestones.find(m=>m.id==id);showModal(`<h2>Edytuj milestone</h2><div class="modal-grid"><div class="field span2"><label>Nazwa</label><input id="emName" value="${esc(x.name)}"></div><div class="field"><label>Kolejność</label><input id="emSeq" type="number" value="${x.seq}"></div><div class="field"><label>Deadline</label><input id="emDl" type="datetime-local" value="${x.deadline?x.deadline.slice(0,16):''}"></div><div class="field"><label>Owner</label><select id="emOwner"><option value="">—</option>${S.users.map(u=>`<option value="${u.id}" ${x.owner_user_id==u.id?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div><div class="field"><label>Komentarz</label><input id="emComment" value="${esc(x.comment||'')}"></div></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveMilestoneEdit(${id})">Zapisz</button></div>`)}
async function saveMilestoneEdit(id){await api('/api/milestones/'+id,{method:'PATCH',body:JSON.stringify({name:$('#emName').value,seq:+$('#emSeq').value,deadline:$('#emDl').value||null,owner_user_id:+$('#emOwner').value||null,comment:$('#emComment').value})});closeModal();await openOrder(S.order.order.id);S.activeTab='milestones';renderOrder();}
function renderDocuments(){const d=S.order.documents;$('#tabBody').innerHTML=`<div class="panel"><h3>Dokumenty zlecenia</h3><div class="uploadbox"><div class="field"><label>Plik (max 10 MB)</label><input id="docFile" type="file"></div><div class="field"><label>Usuń po</label><input id="docExp" type="date" value="${new Date(Date.now()+30*86400000).toISOString().slice(0,10)}"></div><button class="primary" onclick="uploadDoc()">Wgraj</button></div>${d.length?d.map(x=>`<div class="docrow"><div><b>${esc(x.filename)}</b><div class="muted">${Math.round(x.size/1024)} KB · ${esc(x.user_name)} · ${fmt(x.created_at)}</div></div><div>${x.warning?`<span class="docwarn">⚠ ${x.days_left} dni</span>`:''} <a class="mini" style="text-decoration:none" href="/api/documents/${x.id}/download">pobierz</a></div></div>`).join(''):'<div class="empty">Brak dokumentów</div>'}</div>`}
async function uploadDoc(){const f=$('#docFile').files[0];if(!f)return toast('Wybierz plik',true);const b64=await fileBase64(f);const exp=$('#docExp').value?new Date($('#docExp').value+'T23:59:00').toISOString():null;await api('/api/orders/'+S.order.order.id+'/documents',{method:'POST',body:JSON.stringify({filename:f.name,mime:f.type,content_base64:b64,expires_at:exp})});toast('Dokument wgrany');await openOrder(S.order.order.id);S.activeTab='documents';renderOrder();}
function fileBase64(f){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(String(r.result).split(',')[1]);r.onerror=rej;r.readAsDataURL(f)})}
function renderIncidents(){const inc=S.order.incidents;$('#tabBody').innerHTML=`<div class="panel"><div class="actions-row" style="justify-content:flex-start;margin-top:0"><button class="primary" onclick="incidentModal()">+ Utwórz incydent</button></div>${inc.length?inc.map(i=>`<div class="incidentrow"><div><b>${esc(i.title)}</b><div class="muted">${esc(i.category)} · ${fmt(i.created_at)} · ${esc(i.status)}</div><p>${esc(i.description||'')}</p>${i.root_cause_suggested?`<div class="badge warn">suggested root cause: ${esc(i.root_cause_suggested)}</div>`:''}${i.root_cause_accepted?` <div class="badge ok">accepted: ${esc(i.root_cause_accepted)}</div>`:''}</div><div><button class="mini" onclick="incidentChronology(${i.id})">chronologia</button> <button class="mini" onclick="editIncident(${i.id})">root cause</button></div></div>`).join(''):'<div class="empty">Incydent powstaje tylko na żądanie użytkownika.</div>'}</div>`}
function incidentModal(){showModal(`<h2>Nowy incydent</h2><div class="modal-grid"><div class="field"><label>Kategoria</label><select id="inCat"><option>carrier</option><option>dispatch</option><option>forwarder</option><option>client</option><option>customs</option><option>external</option></select></div><div class="field"><label>Tytuł</label><input id="inTitle"></div><div class="field span2"><label>Opis</label><textarea id="inDesc"></textarea></div><div class="field span2"><label>Sugerowany root cause</label><input id="inRoot" placeholder="system/operator może zasugerować; spedytor akceptuje"></div></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveIncident()">Utwórz</button></div>`)}
async function saveIncident(){await api('/api/orders/'+S.order.order.id+'/incidents',{method:'POST',body:JSON.stringify({category:$('#inCat').value,title:$('#inTitle').value,description:$('#inDesc').value,root_cause_suggested:$('#inRoot').value})});closeModal();await openOrder(S.order.order.id);S.activeTab='incidents';renderOrder();}

function editIncident(id){const i=S.order.incidents.find(x=>x.id==id);const canAccept=S.user.role==='spedytor'||S.user.role==='supervisor';showModal(`<h2>Root cause / status incydentu</h2><div class="field"><label>Sugerowany root cause</label><textarea id="eiSug">${esc(i.root_cause_suggested||'')}</textarea></div><div class="field"><label>Zaakceptowany root cause</label><textarea id="eiAcc" ${canAccept?'':'disabled'}>${esc(i.root_cause_accepted||'')}</textarea></div><div class="field"><label>Status</label><select id="eiStatus"><option ${i.status==='open'?'selected':''}>open</option><option ${i.status==='investigating'?'selected':''}>investigating</option><option ${i.status==='closed'?'selected':''}>closed</option></select></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveIncidentEdit(${id},${canAccept})">Zapisz</button></div>`)}
async function saveIncidentEdit(id,canAccept){const data={root_cause_suggested:$('#eiSug').value,status:$('#eiStatus').value};if(canAccept)data.root_cause_accepted=$('#eiAcc').value;await api('/api/incidents/'+id,{method:'PATCH',body:JSON.stringify(data)});closeModal();await openOrder(S.order.order.id);S.activeTab='incidents';renderOrder();}
function incidentChronology(id){const i=S.order.incidents.find(x=>x.id==id);const events=[...S.order.audit].reverse();showModal(`<h2>${esc(i.title)} · chronologia zlecenia</h2><p>Automatyczny zestaw wpisów audytowych do dalszej selekcji w raporcie incydentu.</p><div class="timeline">${events.map(x=>`<div class="event"><div class="event-time">${fmt(x.created_at)}</div><div><div class="event-title">${esc(x.summary)}</div><div class="event-meta">${esc(x.source)} · ${esc(x.user_name||'system')}</div></div></div>`).join('')}</div><div class="modal-actions"><button class="primary" onclick="closeModal()">Zamknij</button></div>`)}
function renderStats(){const m=S.order.metrics;const o=S.order.order;const plateChanges=S.order.audit.filter(a=>a.details_obj?.field==='tractor_plate'||a.details_obj?.field==='trailer_plate').length;const etaChanges=S.order.audit.filter(a=>JSON.stringify(a.details_obj||{}).toLowerCase().includes('eta')).length;$('#tabBody').innerHTML=`<div class="cards">${metric('Zadania',m.tasks_total,'w zleceniu')}${metric('Otwarte',m.tasks_open,'wymagają działania',m.tasks_open?'warn':'ok')}${metric('Late / critical',m.late+' / '+m.critical,'SLA')}${metric('Śr. ACK',m.avg_ack_min==null?'—':m.avg_ack_min+' min','reakcja')}${metric('Śr. rozwiązanie',m.avg_resolution_min==null?'—':m.avg_resolution_min+' min','pełna informacja')}${metric('Zmiany deadline',m.deadline_changes,'nie znikają z KPI')}${metric('Zmiany blach',plateChanges,'z historii')}${metric('Zmiany ETA',etaChanges,'z historii')}</div><div class="grid2"><div class="panel"><h3>Ocena końcowa</h3><select id="quality"><option value="">—</option>${['clean transport','minor issue','major incident','claim'].map(x=>`<option ${o.quality_rating===x?'selected':''}>${x}</option>`).join('')}</select><label class="checkline" style="margin-top:12px"><input id="podClose" type="checkbox" ${o.closed_by_pod?'checked':''}> transport zamknięty przez POD</label><button class="primary" onclick="saveQuality()">Zapisz</button></div><div class="panel"><h3>Interpretacja</h3><p>Zmiana deadline, kolejne blachy, brak ACK i czas rozwiązania pozostają mierzalne nawet po zamknięciu zadania. Dzięki temu „sprawdzam” nie jest traktowane jako dostarczenie właściwej informacji.</p></div></div>`}
async function saveQuality(){await api('/api/orders/'+S.order.order.id,{method:'PATCH',body:JSON.stringify({quality_rating:$('#quality').value,closed_by_pod:$('#podClose').checked})});toast('Zapisano ocenę');await openOrder(S.order.order.id);S.activeTab='stats';renderOrder();}
function createOrderModal(){const f=S.users.filter(u=>u.role==='spedytor'),d=S.users.filter(u=>u.role==='dyspozytor');showModal(`<h2>Nowe zlecenie</h2><p>Numer może być wygenerowany przez aplikację albo pozostać pusty jako rozmowa tymczasowa. Duplikat jest blokowany.</p><label class="checkline" style="margin:0 0 12px"><input id="noAuto" type="checkbox" checked> generuj numer w formacie 00000/TRNS/mm/rr</label><div class="modal-grid"><div class="field"><label>Numer ręczny / opcjonalny</label><input id="noNo"></div><div class="field"><label>Tytuł</label><input id="noTitle"></div><div class="field"><label>Kod załadunku *</label><input id="noLoad"></div><div class="field"><label>Kod rozładunku *</label><input id="noUnload"></div><div class="field"><label>Typ auta *</label><input id="noVehicle"></div><div class="field"><label>Towar *</label><input id="noCargo"></div><div class="field"><label>Termin załadunku *</label><input id="noLd" type="datetime-local"></div><div class="field"><label>Termin rozładunku *</label><input id="noUd" type="datetime-local"></div><div class="field"><label>Przewoźnik</label><input id="noCarrier" value="TBD"></div><div class="field"><label>Telefon przewoźnika</label><input id="noCarrierPhone"></div><div class="field"><label>Spedytor</label><select id="noF"><option value="">—</option>${f.map(u=>`<option value="${u.id}" ${S.user.role==='spedytor'&&S.user.id===u.id?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div><div class="field"><label>Dyspozytor</label><select id="noD"><option value="">—</option>${d.map(u=>`<option value="${u.id}" ${S.user.role==='dyspozytor'&&S.user.id===u.id?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="createOrder()">Utwórz</button></div>`)}
async function createOrder(){const data={order_no:$('#noNo').value,generate_number:$('#noAuto').checked,title:$('#noTitle').value,load_code:$('#noLoad').value,unload_code:$('#noUnload').value,vehicle_type:$('#noVehicle').value,cargo:$('#noCargo').value,load_deadline:$('#noLd').value,unload_deadline:$('#noUd').value,carrier:$('#noCarrier').value,carrier_phone:$('#noCarrierPhone').value,owner_forwarder_id:+$('#noF').value||null,dispatcher_id:+$('#noD').value||null};try{const j=await api('/api/orders',{method:'POST',body:JSON.stringify(data)});closeModal();await refreshOrders();await openOrder(j.id)}catch(e){toast(e.message,true)}}
function createUserModal(){showModal(`<h2>Nowe konto</h2><div class="modal-grid"><div class="field"><label>Imię / nazwa</label><input id="cuName"></div><div class="field"><label>Login</label><input id="cuUser"></div><div class="field"><label>Rola</label><select id="cuRole"><option>spedytor</option><option>dyspozytor</option><option>supervisor</option></select></div></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="createUser()">Utwórz</button></div>`)}
async function createUser(){try{await api('/api/users',{method:'POST',body:JSON.stringify({name:$('#cuName').value,username:$('#cuUser').value,role:$('#cuRole').value})});toast('Konto utworzone');closeModal();S.bootstrap=await api('/api/bootstrap');S.users=S.bootstrap.users;renderUser();}catch(e){toast(e.message,true)}}
let lastCritical=0;
async function poll(){if(!S.user)return;try{await refreshOrders();if(S.activeView==='dashboard')await renderDashboard();if(S.order){const typing=S.activeTab==='chat'&&($('#chatText')?.value||document.activeElement===$('#chatText'));if(!typing){const id=S.order.order.id;const b=await api('/api/orders/'+id);const crit=b.metrics?.critical||0;if(crit>lastCritical)toast('Nowe zadanie CRITICAL',true);lastCritical=crit;S.order=b;renderOrder();}}}catch(e){console.debug('poll',e.message)}}
setInterval(poll,5000);
boot().catch(e=>{console.error(e);toast(e.message,true)});
