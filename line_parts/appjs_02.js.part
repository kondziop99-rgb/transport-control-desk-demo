function renderTab(){ if(!S.order)return; ({overview:renderOverview,chat:renderChat,timeline:renderTimeline,milestones:renderMilestones,documents:renderDocuments,incidents:renderIncidents,stats:renderStats}[S.activeTab])(); }
function nameOf(id){return S.users.find(u=>u.id==id)?.name||'';}
function field(label,key,type='text',span='',opts=''){const o=S.order.order; const val=type==='datetime-local'&&o[key]?String(o[key]).slice(0,16):(o[key]||''); if(type==='select')return `<div class="field ${span}"><label>${label}</label><select data-order-field="${key}">${opts}</select></div>`;return `<div class="field ${span}"><label>${label}</label><input type="${type}" data-order-field="${key}" value="${esc(val)}"></div>`}
function renderOverview(){
 const o=S.order.order; const missing=o.missing_fields||[]; const roleopts=['spedytor','dyspozytor','supervisor'].map(x=>`<option ${o.ball_holder_role===x?'selected':''}>${x}</option>`).join('');
 $('#tabBody').innerHTML=`${missing.length?`<div class="alertbox"><strong>Braki / informacje do weryfikacji (${missing.length})</strong><div class="missing-list">${missing.map(m=>`<span class="badge ${m.critical?'danger':'warn'}">${esc(m.label)}</span>`).join('')}</div></div>`:''}<div class="panel"><div class="form-grid">
 ${field('Numer zlecenia','order_no')}${field('Kod załadunku','load_code')}${field('Kod rozładunku','unload_code')}${field('Typ auta','vehicle_type')}
 ${field('Towar','cargo','text','span2')}${field('Klient','client')}${field('Wartość towaru','cargo_value')}
 ${field('Termin załadunku','load_deadline','datetime-local')}${field('Termin rozładunku','unload_deadline','datetime-local')}${field('Przewoźnik','carrier')}${field('Telefon przewoźnika','carrier_phone')}
 ${field('Inny kontakt przewoźnika','carrier_other_contact')}${field('Kierowca','driver_name')}${field('Telefon kierowcy','driver_phone')}${field('Ciągnik','tractor_plate')}
 ${field('Naczepa','trailer_plate')}${field('GPS link','gps_link')}${field('Typ GPS','gps_type')}${field('GPS ważny do','gps_expires_at','datetime-local')}
 ${field('Ubezpieczenie','insurance_info','text','span2')}<div class="field span2"><label>Piłka po stronie</label><select data-order-field="ball_holder_role">${roleopts}</select></div>
 <div class="field span4"><label>Wymagania (tail-lift / ADR / HPT / side loading / dedicated / no transshipment / customs...)</label><textarea data-order-field="requirements">${esc(o.requirements||'')}</textarea></div>
 </div><div class="actions-row">${S.user.role==='supervisor'?'<button class="ghost" onclick="assignmentModal()">Zmień przypisanie</button>':''}<button class="primary" onclick="saveOrderFields()">Zapisz zmiany</button></div></div>`;
}
async function saveOrderFields(){const data={}; $$('[data-order-field]').forEach(el=>data[el.dataset.orderField]=el.value); try{await api('/api/orders/'+S.order.order.id,{method:'PATCH',body:JSON.stringify(data)}); toast('Zapisano i dodano do historii'); await openOrder(S.order.order.id);}catch(e){toast(e.message,true)}}
function assignmentModal(){const o=S.order.order; const f=S.users.filter(u=>u.role==='spedytor'),d=S.users.filter(u=>u.role==='dyspozytor');showModal(`<h2>Przypisanie zlecenia</h2><p>Zmiana jest rejestrowana w audycie. Użytkownik nie może samodzielnie „przekazać sobie” zlecenia.</p><div class="modal-grid"><div class="field"><label>Spedytor</label><select id="asF">${f.map(u=>`<option value="${u.id}" ${o.owner_forwarder_id==u.id?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div><div class="field"><label>Dyspozytor</label><select id="asD"><option value="">—</option>${d.map(u=>`<option value="${u.id}" ${o.dispatcher_id==u.id?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveAssignment()">Zapisz</button></div>`)}
async function saveAssignment(){await api('/api/orders/'+S.order.order.id,{method:'PATCH',body:JSON.stringify({owner_forwarder_id:+$('#asF').value,dispatcher_id:$('#asD').value?+$('#asD').value:null})});closeModal();toast('Przypisanie zmienione');await openOrder(S.order.order.id)}
function findReply(id){const m=S.order.messages.find(x=>x.id==id);return m?`${m.user_name}: ${m.text}`:''}
function renderChat(){
 const msgs=S.order.messages, tasks=S.order.tasks; $('#tabBody').innerHTML=`<div class="chat-layout"><div class="chatbox"><div class="messages" id="messages">${msgs.length?msgs.map(m=>`<div class="msg ${m.user_id===S.user.id?'mine':''}"><div class="msgmeta">${esc(m.user_name)} · ${fmt(m.created_at)}</div>${m.reply_to_id?`<div class="replyquote">↳ ${esc(findReply(m.reply_to_id)).slice(0,180)}</div>`:''}<div>${esc(m.text).replace(/\n/g,'<br>')}</div><div class="reactions"><button class="react" onclick="react(${m.id},'👍')">👍 ${m.reactions['👍']||''}</button><button class="react" onclick="react(${m.id},'ACK')">ACK ${m.reactions['ACK']||''}</button><button class="react" onclick="react(${m.id},'IMPORTANT')">! ${m.reactions['IMPORTANT']||''}</button><button class="react" onclick="setReply(${m.id})">odpowiedz</button></div></div>`).join(''):'<div class="empty">Rozpocznij rozmowę w ramach zlecenia.</div>'}</div><div class="composer">${S.replyTo?`<div class="replyquote">Odpowiadasz na: ${esc(findReply(S.replyTo))} <button class="mini" onclick="setReply(null)">×</button></div>`:''}<textarea id="chatText" placeholder="Napisz wiadomość… np. 'proszę o GPS i ETA'" oninput="suggestTask()"></textarea><div id="taskSuggestion"></div><div class="composer-top"><span class="muted">Wiadomości nie są edytowalne ani usuwalne.</span><button class="primary" onclick="sendMessage()">Wyślij</button></div></div></div><div class="taskbox"><h3>Kolejka informacji / SLA</h3><button class="ghost full" onclick="newTaskModal()">+ Zadanie ręczne</button><div style="height:8px"></div>${tasks.length?tasks.map(taskHtml).join(''):'<div class="empty">Brak zadań</div>'}</div></div>`;
 setTimeout(()=>{const x=$('#messages');if(x)x.scrollTop=x.scrollHeight},20); suggestTask();
}
function taskHtml(t){return `<div class="task ${t.sla_state} ${t.status==='resolved'?'resolved':''}"><div class="task-title">${esc(t.title)}</div><div class="task-meta">${esc(t.assigned_name||'nieprzypisane')} · ${t.no_deadline?'bez terminu':fmt(t.deadline)} · <b>${esc(t.sla_state)}</b></div><div class="task-meta">ACK: ${t.ack_minutes==null?'—':t.ack_minutes+' min'} · rozwiązanie: ${t.resolution_minutes==null?'—':t.resolution_minutes+' min'} · zmiany deadline: ${t.deadline_changed_count}</div><div class="task-actions">${!t.ack_at&&t.status!=='resolved'?`<button class="mini" onclick="taskAction(${t.id},'ack')">ACK</button>`:''}${t.status!=='resolved'?`<button class="mini" onclick="taskAction(${t.id},'resolve')">Rozwiązane</button><button class="mini" onclick="deadlineModal(${t.id})">Deadline</button>`:`<button class="mini" onclick="taskAction(${t.id},'reopen')">Otwórz</button>`}</div></div>`}
function detectTask(text){const t=text.toLowerCase(); const map=[['gps',['gps','tracking']],['vehicle_data',['blach','plate','rejestr']],['driver_data',['kierow','driver']],['eta',['eta','pozycj','arrival']],['pod',['pod']],['cmr',['cmr']],['customs',['custom','celn','t1','gmr','ata']],['info_requested',['prosz','potrzeb','potwierd','sprawdź','sprawdz']]]; for(const [k,arr] of map) if(arr.some(w=>t.includes(w))) return k; return null;}
function suggestTask(){const el=$('#chatText'),box=$('#taskSuggestion');if(!el||!box)return;const k=detectTask(el.value);if(!k){box.innerHTML='';return;}const tpl=S.bootstrap.task_templates[k];box.innerHTML=`<div class="suggestion"><label><input id="createSuggestedTask" type="checkbox" checked> Utwórz oczekujące zadanie przed wysłaniem</label><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px"><select id="suggestTpl">${Object.entries(S.bootstrap.task_templates).map(([key,v])=>`<option value="${key}" ${key===k?'selected':''}>${esc(v.label)} · ${v.minutes} min</option>`).join('')}</select><select id="suggestAssigned"><option value="">nieprzypisane</option>${S.users.map(u=>`<option value="${u.id}" ${u.id==defaultAssignee()?'selected':''}>${esc(u.name)}</option>`).join('')}</select></div></div>`}
function defaultAssignee(){const o=S.order.order;if(S.user.role==='spedytor')return o.dispatcher_id;if(S.user.role==='dyspozytor')return o.owner_forwarder_id;return o.dispatcher_id||o.owner_forwarder_id;}
async function sendMessage(){const text=$('#chatText').value.trim();if(!text)return;let task=null;if($('#createSuggestedTask')?.checked){const key=$('#suggestTpl').value;task={template_key:key,title:S.bootstrap.task_templates[key].label,assigned_to:+$('#suggestAssigned').value||null};}await api('/api/orders/'+S.order.order.id+'/messages',{method:'POST',body:JSON.stringify({text,reply_to_id:S.replyTo,task})});S.replyTo=null;await openOrder(S.order.order.id);S.activeTab='chat';renderOrder();}
function setReply(id){S.replyTo=id;renderChat();}
async function react(id,r){await api('/api/messages/'+id+'/reactions',{method:'POST',body:JSON.stringify({reaction:r})});await openOrder(S.order.order.id);S.activeTab='chat';renderOrder();}
async function taskAction(id,action){await api('/api/tasks/'+id,{method:'PATCH',body:JSON.stringify({action})});await openOrder(S.order.order.id);S.activeTab='chat';renderOrder();}
function newTaskModal(){showModal(`<h2>Nowe zadanie / oczekiwana informacja</h2><div class="modal-grid"><div class="field"><label>Typ</label><select id="ntTpl">${Object.entries(S.bootstrap.task_templates).map(([k,v])=>`<option value="${k}">${esc(v.label)} · ${v.minutes} min</option>`).join('')}</select></div><div class="field"><label>Przypisz</label><select id="ntUser"><option value="">—</option>${S.users.map(u=>`<option value="${u.id}">${esc(u.name)}</option>`).join('')}</select></div><div class="field span2"><label>Tytuł</label><input id="ntTitle"></div><label><input type="checkbox" id="ntNo"> bez terminu ważności</label></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="createTask()">Utwórz</button></div>`)}
async function createTask(){await api('/api/orders/'+S.order.order.id+'/tasks',{method:'POST',body:JSON.stringify({template_key:$('#ntTpl').value,title:$('#ntTitle').value||undefined,assigned_to:+$('#ntUser').value||null,no_deadline:$('#ntNo').checked})});closeModal();await openOrder(S.order.order.id);S.activeTab='chat';renderOrder();}
function deadlineModal(id){showModal(`<h2>Zmiana deadline</h2><p>Każda zmiana jest liczona do KPI i wymaga powodu.</p><div class="field"><label>Nowy termin</label><input id="dlNew" type="datetime-local"></div><div class="field"><label>Powód</label><textarea id="dlReason"></textarea></div><div class="modal-actions"><button class="ghost" onclick="closeModal()">Anuluj</button><button class="primary" onclick="saveDeadline(${id})">Zapisz</button></div>`)}
async function saveDeadline(id){try{await api('/api/tasks/'+id,{method:'PATCH',body:JSON.stringify({deadline:$('#dlNew').value,reason:$('#dlReason').value})});closeModal();await openOrder(S.order.order.id);S.activeTab='chat';renderOrder()}catch(e){toast(e.message,true)}}
