def now_dt():
    return datetime.now().astimezone()


def now_iso():
    return now_dt().isoformat(timespec="seconds")


def parse_iso(value):
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(value)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=now_dt().tzinfo)
        return dt
    except Exception:
        return None


